# Backend server configuration
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Security controls
REQUEST_TIMEOUT_MS=15000
UPSTREAM_TIMEOUT_MS=12000
REQUEST_BODY_LIMIT=16kb
MAX_PROMPT_CHARS=2000
MAX_MESSAGE_CHARS=4000
MAX_TURNS=20
MAX_MESSAGES=40
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Upstream AI API configuration
UPSTREAM_API_URL=https://api.openai.com/v1/chat/completions
UPSTREAM_MODEL=gpt-4o-mini

# PostgreSQL is optional; omit DATABASE_URL to run chat without persistence.
# Change this local password and use the same URL-encoded value in DATABASE_URL.
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://gateway:change-this-local-password@127.0.0.1:5432/gateway
DB_POOL_MAX=5
DB_TIMEOUT_MS=1500
TELEMETRY_QUEUE_SIZE=500
TELEMETRY_RETENTION_DAYS=30

# Analytics is opt-in and local development only; never enable in production.
ANALYTICS_LOCAL_ENABLED=false
# Generate a distinct random secret (32+ characters), then uncomment:
# ANALYTICS_LOCAL_SECRET=replace-with-a-random-administrator-secret
